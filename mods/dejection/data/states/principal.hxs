function update(elapsed:Float)
{
    if (!bfexeoptFinished)
    {
        bfexeoptTimer +=
            elapsed;

        bfexeoptName.y =
            (FlxG.height / 2)
            + 45
            + Math.sin(
                bfexeoptTimer * 2
            ) * 5;

        if (bfexeoptSprite != null)
        {
            bfexeoptSprite.x =
                (FlxG.width / 2) - 190;

            bfexeoptSprite.y =
                bfexeoptName.y - 35;
        }

        if (bfexeoptIcon != null)
        {
            bfexeoptIcon.y =
                (FlxG.height / 2)
                + 105
                + Math.sin(
                    bfexeoptTimer * 2
                ) * 5;

            bfexeoptIcon.angle +=
                290 * elapsed;
        }

        if (
            bfexeoptTimer >= 3.5
        )
        {
            bfexeoptFinished =
                true;

            FlxTween.tween(
                bfexeoptTitle,
                {alpha: 0},
                0.4
            );

            FlxTween.tween(
                bfexeoptBy,
                {alpha: 0},
                0.4
            );

            FlxTween.tween(
                bfexeoptIcon,
                {alpha: 0},
                0.4
            );

            FlxTween.tween(
                bfexeoptSprite,
                {alpha: 0},
                0.4
            );

            FlxTween.tween(
                bfexeoptName,
                {alpha: 0},
                0.4,
                {
                    onComplete:
                    function(_)
                    {
                        remove(
                            bfexeoptTitle
                        );

                        remove(
                            bfexeoptBy
                        );

                        remove(
                            bfexeoptIcon
                        );

                        bfexeoptIcon.destroy();
                        bfexeoptIcon = null;

                        remove(
                            bfexeoptSprite
                        );

                        bfexeoptSprite.destroy();
                        bfexeoptSprite = null;

                        remove(
                            bfexeoptName
                        );

                        bfexeoptTitle.destroy();
                        bfexeoptBy.destroy();
                        bfexeoptName.destroy();

                        bfexeoptTitle = null;
                        bfexeoptBy = null;
                        bfexeoptName = null;

                        bg.visible =
                            true;

                        shadowthehedgehog.visible =
                            true;

                        for (p in particulas)
                        {
                            if (p != null)
                                p.visible =
                                    true;
                        }

                        for (spr in elementos)
                        {
                            if (spr != null)
                                spr.visible =
                                    true;
                        }

                        hint.visible =
                            true;

                        mudandomodo(
                            0,
                            true
                        );
                    }
                }
            );
        }

        return;
    }

    if (!elementoselecionado)
    {
        for (p in particulas)
        {
            if (p == null)
                continue;

            p.x +=
                p.velocity.x
                * elapsed;

            p.y +=
                p.velocity.y
                * elapsed;

            if (p.x > FlxG.width)
                p.x = 0;

            if (p.x < 0)
                p.x =
                    FlxG.width;

            if (p.y > FlxG.height)
                p.y = 0;

            if (p.y < 0)
                p.y =
                    FlxG.height;
        }

        if (
            controls.UP_P ||
            FlxG.keys.justPressed.UP
        )
        {
            mudandomodo(-1);
        }

        if (
            controls.DOWN_P ||
            FlxG.keys.justPressed.DOWN
        )
        {
            mudandomodo(1);
        }

        if (
            controls.ACCEPT ||
            FlxG.keys.justPressed.ENTER ||
            FlxG.keys.justPressed.SPACE
        )
        {
            selecionandomodo();
        }

        if (
            FlxG.keys.justPressed.SEVEN
        )
        {
            persistentUpdate =
                false;

            persistentDraw =
                true;

            openSubState(
                new EditorPicker()
            );
        }

        if (
            controls.SWITCHMOD
        )
        {
            persistentUpdate =
                false;

            persistentDraw =
                true;

            openSubState(
                new ModSwitchMenu()
            );
        }
    }

    if (
        FlxG.keys.justPressed.NINE ||
        FlxG.keys.justPressed.NUMPADNINE
    )
    {
        trailer();

        return;
    }

    for (spr in elementos)
    {
        if (spr == null)
            continue;

        if (
            FlxG.mouse.overlaps(
                spr
            )
        )
        {
            if (
                spr.ID !=
                elementosvalor
            )
            {
                elementosvalor =
                    spr.ID;

                mudandomodo(
                    0,
                    true
                );
            }

            if (
                FlxG.mouse.justPressed &&
                !elementoselecionado
            )
            {
                selecionandomodo();
            }

            break;
        }
    }

    if (controls.BACK)
    {
        window.close();
    }
}

function trailer()
{
    FlxG.camera.fade(
        FlxColor.BLACK,
        1,
        false,
        function()
        {
            FlxG.switchState(
                new ModState(
                    "trailer"
                )
            );
        },
        true
    );
}

function mudandomodo(
    huh:Int = 0,
    isStarting:Bool = false
)
{
    if (!isStarting)
    {
        FlxG.sound.play(
            Paths.sound(
                "scrollMenu"
            )
        );
    }

    elementosvalor =
        FlxMath.wrap(
            elementosvalor + huh,
            0,
            optionShit.length - 1
        );

    FlxG.save.data.menuSelection =
        elementosvalor;

    FlxG.save.flush();

    for (spr in elementos)
    {
        if (spr == null)
            continue;

        spr.animation.play(
            "idle"
        );

        spr.scale.set(
            0.8,
            0.8
        );

        spr.alpha =
            1;

        spr.color =
            FlxColor.GRAY;

        if (
            spr.ID ==
            elementosvalor
        )
        {
            spr.animation.play(
                "selected"
            );

            spr.color =
                FlxColor.WHITE;
        }
    }
}

function selecionandomodo()
{
    if (elementoselecionado)
        return;

    elementoselecionado =
        true;

    FlxG.sound.play(
        Paths.sound(
            "confirmMenu"
        )
    );

    if (
        optionShit[elementosvalor]
        == "1"
    )
    {
        MusicBeatState.skipTransOut =
            true;

        FlxG.switchState(
            new FreeplayState()
        );

        return;
    }

    FlxTween.tween(
        FlxG.camera,
        {zoom: 2},
        2,
        {
            ease:
                FlxEase.expoInOut,

            onComplete:
            function(_)
            {
                switch (
                    optionShit[
                        elementosvalor
                    ]
                )
                {
                    case "2":

                        FlxG.switchState(
                            new ModState(
                                "creditos"
                            )
                        );

                    case "3":

                        FlxG.switchState(
                            new OptionsMenu()
                        );
                }
            }
        }
    );
}