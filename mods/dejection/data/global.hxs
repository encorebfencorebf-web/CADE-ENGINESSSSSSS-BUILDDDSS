// livraria (imports) e basicos do codename //
import funkin.backend.utils.ShaderResizeFix;
import funkin.backend.utils.WindowUtils;
import funkin.backend.system.framerate.Framerate;

// livraria (imports) e basicos pra nova resolução //
import openfl.system.Capabilities; import openfl.Lib;
var largura:Int = 0, altitude:Int = 0;

// sistema inspirado do Hello Again John Doe de @RILEYTRONIC, ent, obrigado aos envolvidos //
function preStateSwitch() {FlxG.mouse.visible = true;}
function new() {windowShit(1840, 864, 0.8);}

// proporção pra nova resolução //
function aspectShit(width:Int, height:Int):Void {
    var idk1 = height, idk2 = width; while (idk1 != 0) {idk1 = idk2 % idk1; idk2 = height;}
    largura = Math.floor(Capabilities.screenResolutionX * ((height / idk2) / (width / idk2))) >
    Capabilities.screenResolutionY ? Math.floor(Capabilities.screenResolutionY * ((width / idk2) / (height / idk2))) : Capabilities.screenResolutionX;
    altitude = Math.floor(Capabilities.screenResolutionX * ((height / idk2) / (width / idk2))) >
    Capabilities.screenResolutionY ? Capabilities.screenResolutionY : Math.floor(Capabilities.screenResolutionX * ((height / idk2) / (width / idk2)));
}

 //state

static var MAIN_STATE:String = "principal";

static var FREEPLAY_STATE:String = "dev";

