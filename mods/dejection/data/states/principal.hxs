var bfexeoptTimer:Float = 0;
var bfexeoptFinished:Bool = false;

var protectedName:String = "BFEXEOPT";
var protectedLength:Int = 8;
var originalChecksum:Int = 0;

function calculateChecksum(text:String):Int
{
    var result:Int = 17;

    for (i in 0...text.length)
    {
        result =
            (
                (result * 31)
                + text.charCodeAt(i)
                + (i * 7)
            ) % 100000;
    }

    return result;
}

function verifyBFEXEOPT():Bool
{
    if (protectedName.length != protectedLength)
        return false;

    if (protectedName != "BFEXEOPT")
        return false;

    if (calculateChecksum(protectedName) != originalChecksum)
        return false;

    return true;
}

function showBFEXEOPTWarning()
{
    var warning:FunkinText = new FunkinText(
        0,
        0,
        FlxG.width,
        "WARNING\nBFEXEOPT TEXT HAS BEEN MODIFIED!",
        28
    );

    warning.font = Paths.font("vcr.ttf");
    warning.color = FlxColor.RED;
    warning.alignment = "center";
    warning.screenCenter();

    add(warning);

    FlxTween.tween(
        warning,
        {alpha: 0},
        2.5,
        {
            startDelay: 2,
            ease: FlxEase.quadOut,

            onComplete: function(_)
            {
                remove(warning);
                warning.destroy();
            }
        }
    );
}

