// livraria (imports) e basicos da nota de tela //
import flixel.tweens.FlxEase; import flixel.util.FlxTimer;
var nota1:Array<FunkinSprite> = []; var nota2:Array<Bool> = []; var nota3:Array<FlxTimer> = [];
var camera:HudCamera; var quantidade:Int = 3;

// basicos para as notas ingame //
function onPlayerHit(e) {
    if (e == null) return;

    if (e.noteType == "screamer") {
        e.cancel();
        scream2();
    }
}
function onPlayerMiss(e) {
    if (e == null) return;

    if (e.noteType == "screamer") {
        e.cancel(true);

        if (e.note != null && e.note.strumLine != null) {
            e.note.strumLine.deleteNote(e.note);
        }
    }
}

function onNoteCreation(e) {
    if (e == null) return;

    if (e.noteType == "screamer") {
        e.noteSprite = "game/notes/screamer";
    }
}

function create() {
    // unica opção que eu achei pra que a camera ingame não ficasse preta //
    camera = new FlxCamera(0, 0, FlxG.width, FlxG.height);
    camera.bgColor = 0x00000000; FlxG.cameras.add(camera, false);

    // hi = new FlxSprite(0, 0); hi.frames = Paths.getSparrowAtlas("menus/hello"); //
    // hi.animation.addByPrefix("HI", "hi", 30, true); hi.animation.play("HI"); //
    // hi.x = FlxG.random.float(50, FlxG.width - hi.width - 50); hi.y = FlxG.random.float(50, FlxG.height - hi.height - 50); //
    // hi.scale.set(0.6, 0.5); hi.updateHitbox(); add(hi); //
    
    for (i in 0...quantidade) {
    var s = new FunkinSprite(); s.frames = Paths.getSparrowAtlas("game/mecanicas/SCREAMER");
    s.animation.addByPrefix("SCREAMER instancia 1", "SCREAMER instancia 1", 30, true); s.animation.play("SCREAMER instancia 1");
    s.cameras = [camera]; s.screenCenter(); s.alpha = 0;
    add(s); nota1.push(s); nota2.push(false); nota3.push(null);}
}


function screamer1(s:FunkinSprite, i:Int, startScale:Float) {
    s.alpha = 1; s.animation.play("SCREAMER instancia 1", true); s.scale.set(2, 2);
    FlxTween.tween(s.scale, {x: 2, y: 2}, 0.15, {ease: FlxEase.quadOut}); FlxG.sound.play(Paths.sound("static"));
    if (nota3[i] != null) nota3[i].cancel(); nota3[i] = new FlxTimer().start(0.6, function(tmr:FlxTimer) {
    FlxTween.tween(s, {alpha: 0}, 0.1, {onComplete: function(twn:FlxTween) {nota2[i] = false; nota3[i] = null;}});});
}

function scream2() {
    for (i in 0...nota1.length) {if (!nota2[i]) {
    nota2[i] = true; screamer1(nota1[i], i, 1); return;}}
    nota2[0] = true;screamer1(nota1[0], 0, 1.1);
}

function destroy() {
    for (i in 0...nota1.length) {
        if (nota3[i] != null)
            nota3[i].cancel();

        if (nota1[i] != null)
            nota1[i].destroy();
    }

    nota1 = [];
    nota2 = [];
    nota3 = [];
}